# IronClaw on SecretVM — env example.
#
# Copy to `.env` and fill in the CHANGE_ME values.
# The real `.env` is uploaded with `secretvm-cli vm create -e <env>` and must
# NOT be committed to git (.gitignore covers this).
#
# Generate values:
#   POSTGRES_PASSWORD     -> openssl rand -hex 24
#   SECRETS_MASTER_KEY    -> openssl rand -base64 32     (must be 32 bytes; base64-encoded ~44 chars)
#   GATEWAY_AUTH_TOKEN    -> openssl rand -hex 32
#   LLM_API_KEY           -> from your SecretInference / attestai.io account

# ── Postgres ─────────────────────────────────────────────────────────────
# Used by both the postgres container init and the DATABASE_URL in compose.
POSTGRES_PASSWORD=CHANGE_ME

# ── IronClaw bootstrap ───────────────────────────────────────────────────
# Master key for the encrypted secrets table. KeySource::Env mode — no OS
# keychain needed. Lose this key and the secrets store is unrecoverable.
SECRETS_MASTER_KEY=CHANGE_ME

# ── LLM backend (SecretInference) ────────────────────────────────────────
# OpenAI-compatible. LLM_BASE_URL should include the version suffix
# (e.g. .../v1) as per OpenAI client convention. Confirm the canonical URL
# and model name against the SecretInference docs before deploy.
LLM_BASE_URL=https://attestai.io/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME

# ── Web gateway auth ─────────────────────────────────────────────────────
# Required to call the gateway. Send as: `Authorization: Bearer <token>`.
GATEWAY_AUTH_TOKEN=CHANGE_ME

# ── Agent identity (optional) ────────────────────────────────────────────
AGENT_NAME=ironclaw

# ── DO NOT SET ───────────────────────────────────────────────────────────
# Setting NEARAI_BASE_URL + NEARAI_API_KEY at startup causes IronClaw to
# bootstrap a NEAR-AI MCP server. We don't want that for the POC. Leave
# both unset.
#
# NEARAI_BASE_URL=
# NEARAI_API_KEY=
