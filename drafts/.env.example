# IronClaw on SecretVM — env example.
#
# Copy to `.env` and fill in the CHANGE_ME values.
# The real `.env` is uploaded with `secretvm-cli vm create -e <env>` and must
# NOT be committed to git (.gitignore covers this).
#
# Generate values:
#   POSTGRES_PASSWORD     -> openssl rand -hex 24
#   SECRETS_MASTER_KEY    -> openssl rand -base64 32     (must be 32 bytes; base64-encoded ~44 chars)
#   GATEWAY_AUTH_TOKEN    -> openssl rand -hex 32
#   LLM_API_KEY           -> from your SecretAI account

# ── Postgres ─────────────────────────────────────────────────────────────
# Used by both the postgres container init and the DATABASE_URL in compose.
POSTGRES_PASSWORD=CHANGE_ME

# ── IronClaw bootstrap ───────────────────────────────────────────────────
# Master key for the encrypted secrets table. KeySource::Env mode — no OS
# keychain needed. Lose this key and the secrets store is unrecoverable.
SECRETS_MASTER_KEY=CHANGE_ME

# ── LLM backend (SecretAI) ───────────────────────────────────────────────
# SecretAI is OpenAI-compatible via Ollama. Standard Bearer auth.
# Supported endpoints (relevant ones): /v1/chat/completions (streaming),
# /v1/completions, /v1/models, tool/function calling for select models.
# /v1/responses is NOT supported, but IronClaw's openai_compatible backend
# uses /v1/chat/completions so that's fine.
#
# LLM_BASE_URL: use the bare origin, no `/v1` suffix. IronClaw appends
# the OpenAI path segments itself; adding `/v1` here doubles up.
#
# Available models on this SecretAI instance (curl /v1/models to recheck):
#   qwen2.5:72b              <- recommended (strong tool calling)
#   qwen3:8b
#   deepseek-r1:70b          <- reasoning; tool calling not advertised
#   gemma3:4b
#   llama3.2-vision:latest   <- vision-focused
LLM_BASE_URL=https://secretai-rytn.scrtlabs.com:21434
LLM_API_KEY=CHANGE_ME
LLM_MODEL=qwen2.5:72b

# ── Web gateway auth ─────────────────────────────────────────────────────
# Required to call the gateway. Send as: `Authorization: Bearer <token>`.
GATEWAY_AUTH_TOKEN=CHANGE_ME

# ── Agent identity (optional) ────────────────────────────────────────────
AGENT_NAME=ironclaw

# ── DO NOT SET ───────────────────────────────────────────────────────────
# Setting NEARAI_BASE_URL + NEARAI_API_KEY at startup causes IronClaw to
# bootstrap a NEAR-AI MCP server. We don't want that for the POC. Leave
# both unset.
#
# NEARAI_BASE_URL=
# NEARAI_API_KEY=
