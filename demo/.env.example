# Copy to demo/.env and fill in the real values. .env is gitignored.
# These values feed setup_routines.py and fire_now.py — they are NOT uploaded
# to IronClaw directly; the setup script builds the routine prompts from them.

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=CHANGE_ME

# Telegram chat ID where routines should post (private DM or group)
# To find yours: send a message to your bot, then GET
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=CHANGE_ME

# IronClaw gateway URL (no trailing slash)
# Local:  http://127.0.0.1:3030
# Live:   https://purple-hare.vm.scrtlabs.com
IRONCLAW_BASE=http://127.0.0.1:3030

# IronClaw container/VM access — pick whichever matches your target.
# Local docker (fire_now.py auto-discovers GATEWAY_AUTH_TOKEN via `docker exec`):
IRONCLAW_DOCKER_CONTAINER=ironclaw-test-ironclaw-1
# Live SecretVM (used only if you have SSH; otherwise drive via secretvm-cli):
# IRONCLAW_SSH=root@purple-hare.vm.scrtlabs.com -i ~/.ssh/<key>

# Live target only — the gateway bearer token. Required by fire_now.py when
# IRONCLAW_BASE is remote and `docker exec` isn't available locally.
# Same value as GATEWAY_AUTH_TOKEN in drafts/.env on the SecretVM side.
# IRONCLAW_GATEWAY_TOKEN=
